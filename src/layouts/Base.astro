---
import '../styles/global.css';
import RuntimeChip from '../components/RuntimeChip.svelte';
interface Props { title: string; description?: string; sidebar?: boolean }
const { title, description = 'An interactive, code-first course in economic and business forecasting — run R and Python right in your browser.', sidebar = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://webr.r-wasm.org" crossorigin />
  <script is:inline>
    (() => { try { const t = localStorage.getItem('fl-theme'); if (t) document.documentElement.dataset.theme = t; } catch {} })();
  </script>
</head>
<body class={sidebar ? 'has-sidebar' : ''}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <a class="brand" href={base}>
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="lg" x1="0" x2="1"><stop offset="0" stop-color="#7c5cff"/><stop offset=".6" stop-color="#22d3ee"/><stop offset="1" stop-color="#34d399"/></linearGradient></defs><path d="M3 22 L9 15 L14 18 L19 10" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".9"/><path d="M19 10 L29 5 L29 17 Z" fill="url(#lg)" opacity=".35"/><path d="M19 10 L29 9" stroke="url(#lg)" stroke-width="2.6" stroke-linecap="round"/></svg>
      <span>Forecast<b>Lab</b></span>
    </a>
    <nav class="topnav" aria-label="Main">
      <a href={`${base}chapters/`}>Chapters</a>
      <a href={`${base}playground/`}>Playground</a>
      <a href={`${base}about/`}>About</a>
    </nav>
    <div class="top-right">
      <RuntimeChip client:idle />
      <button class="icon-btn" id="theme-btn" aria-label="Toggle light/dark theme" title="Toggle theme">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
    <div class="read-progress" aria-hidden="true"><i id="rp"></i></div>
  </header>
  <slot />
  <footer class="foot">
    <div>Forecast Lab · ECON 3371 Economic &amp; Business Forecasting · University of Northern Iowa</div>
    <div class="muted">Code runs entirely in your browser via <a href="https://docs.r-wasm.org/webr/">webR</a> and <a href="https://pyodide.org">Pyodide</a>. Data: FRED®, Federal Reserve Bank of St. Louis.</div>
  </footer>
  <script>
    import { watchMath } from '../lib/md';
    watchMath();
    const btn = document.getElementById('theme-btn');
    btn?.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = cur;
      try { localStorage.setItem('fl-theme', cur); } catch {}
      window.dispatchEvent(new CustomEvent('theme-change', { detail: cur }));
    });
    const rp = document.getElementById('rp');
    const onScroll = () => { const h = document.documentElement; const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight); if (rp) rp.style.transform = `scaleX(${p})`; };
    document.addEventListener('scroll', onScroll, { passive: true }); onScroll();
  </script>
  <style is:global>
    .skip { position: absolute; left: -999px; top: 0; z-index: 100; background: var(--accent); color: #fff; padding: .5rem 1rem; }
    .skip:focus { left: 1rem; }
    .topbar { position: sticky; top: 0; z-index: 50; height: var(--header-h); display: flex; align-items: center; gap: 1.5rem; padding: 0 1.25rem; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid var(--border); }
    .brand { display: flex; align-items: center; gap: .55rem; color: var(--text); font-weight: 600; font-size: 1.05rem; letter-spacing: -.01em; text-decoration: none !important; }
    .brand b { font-weight: 800; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .topnav { display: flex; gap: .3rem; }
    .topnav a { color: var(--text-2); font-size: .88rem; font-weight: 550; padding: .4rem .7rem; border-radius: 8px; text-decoration: none; }
    .topnav a:hover { background: var(--surface-2); color: var(--text); }
    @media (max-width: 640px) { .topnav { display: none; } }
    .top-right { margin-left: auto; display: flex; align-items: center; gap: .6rem; }
    .icon-btn { all: unset; cursor: pointer; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9px; color: var(--text-2); border: 1px solid var(--border); }
    .icon-btn:hover { background: var(--surface-2); color: var(--text); }
    :root[data-theme='light'] .icon-btn .sun, :root:not([data-theme='light']) .icon-btn .moon { display: none; }
    .read-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; }
    .read-progress i { display: block; height: 100%; background: var(--grad); transform-origin: left; transform: scaleX(0); }
    .foot { margin-top: 6rem; padding: 2.5rem 1.5rem 3rem; border-top: 1px solid var(--border); font-size: .84rem; text-align: center; display: grid; gap: .4rem; color: var(--text-2); }
  </style>
</body>
</html>
