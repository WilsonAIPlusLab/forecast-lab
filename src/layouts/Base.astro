---
import '../styles/global.css';
import RuntimeChip from '../components/RuntimeChip.svelte';
import { chapters, parts } from '../lib/chapters';
interface Props { title: string; description?: string; sidebar?: boolean; current?: string }
const { title, description = 'An interactive, code-first course in economic and business forecasting — run R and Python right in your browser.', sidebar = false, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Which top-level section are we in? (for aria-current on the main nav)
const path = Astro.url.pathname.replace(/\/?$/, '/');
const section = path === base ? 'home' : path.startsWith(`${base}chapters/`) ? 'chapters' : path.startsWith(`${base}playground/`) ? 'playground' : path.startsWith(`${base}about/`) ? 'about' : '';
const mainLinks = [
  { key: 'home', label: 'Home', href: base },
  { key: 'chapters', label: 'All chapters', href: `${base}chapters/` },
  { key: 'playground', label: 'Playground', href: `${base}playground/` },
  { key: 'about', label: 'About', href: `${base}about/` },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://webr.r-wasm.org" crossorigin />
  <script is:inline>
    (() => { try { const t = localStorage.getItem('fl-theme'); if (t) document.documentElement.dataset.theme = t; } catch {} })();
  </script>
</head>
<body id="top" class={sidebar ? 'has-sidebar' : ''}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" title="Menu: pages and chapters">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <span class="sr-only">Menu</span>
    </button>
    <a class="brand" href={base} aria-label="Forecast Lab home">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="lg" x1="0" x2="1"><stop offset="0" stop-color="#7c5cff"/><stop offset=".6" stop-color="#22d3ee"/><stop offset="1" stop-color="#34d399"/></linearGradient></defs><path d="M3 22 L9 15 L14 18 L19 10" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity=".9"/><path d="M19 10 L29 5 L29 17 Z" fill="url(#lg)" opacity=".35"/><path d="M19 10 L29 9" stroke="url(#lg)" stroke-width="2.6" stroke-linecap="round"/></svg>
      <span>Forecast<b>Lab</b></span>
    </a>
    <nav class="topnav" aria-label="Main">
      <a href={`${base}chapters/`} aria-current={section === 'chapters' ? 'page' : undefined}>Chapters</a>
      <a href={`${base}playground/`} aria-current={section === 'playground' ? 'page' : undefined}>Playground</a>
      <a href={`${base}about/`} aria-current={section === 'about' ? 'page' : undefined}>About</a>
    </nav>
    <div class="top-right">
      <RuntimeChip client:idle />
      <button class="icon-btn" id="theme-btn" type="button" aria-label="Toggle light/dark theme" title="Toggle theme">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
    <div class="read-progress" aria-hidden="true"><i id="rp"></i></div>
  </header>

  <!-- Site menu: the only navigation on narrow screens (top nav and chapter sidebar are hidden there). Native <dialog> traps focus and closes on Esc. -->
  <dialog id="site-menu" class="drawer" aria-labelledby="site-menu-h">
    <div class="drawer-head">
      <h2 id="site-menu-h" class="drawer-h">Menu</h2>
      <button class="icon-btn" type="button" data-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav aria-label="Site">
      <ul class="drawer-main">
        {mainLinks.map((l) => <li><a href={l.href} aria-current={section === l.key && !current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Chapters" class="drawer-ch">
      {parts.map((p) => (
        <div class="drawer-part">
          <h3 class="drawer-ph">{p}</h3>
          <ul>
            {chapters.filter((c) => c.part === p).map((c) => (
              <li><a href={`${base}chapters/${c.slug}/`} aria-current={c.slug === current ? 'page' : undefined} style={`--c:${c.accent}`}><span class="dn">{c.n}</span><span>{c.short}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </dialog>

  <slot />

  <a class="to-top" id="to-top" href="#top" aria-label="Back to top" title="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </a>

  <footer class="site-foot">
    <nav class="foot-nav" aria-label="Footer">
      {mainLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#top">Back to top</a>
    </nav>
    <div>Forecast Lab · ECON 3371 Economic &amp; Business Forecasting · University of Northern Iowa</div>
    <div class="muted">Code runs entirely in your browser via <a href="https://docs.r-wasm.org/webr/">webR</a> and <a href="https://pyodide.org">Pyodide</a>. Data: FRED®, Federal Reserve Bank of St. Louis, and other sources listed on the <a href={`${base}about/#data`}>About page</a>.</div>
  </footer>
  <script>
    import { watchMath } from '../lib/md';
    watchMath();
    const btn = document.getElementById('theme-btn');
    btn?.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = cur;
      try { localStorage.setItem('fl-theme', cur); } catch {}
      window.dispatchEvent(new CustomEvent('theme-change', { detail: cur }));
    });
    const rp = document.getElementById('rp');
    const top = document.getElementById('to-top');
    const onScroll = () => {
      const h = document.documentElement; const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
      if (rp) rp.style.transform = `scaleX(${p})`;
      top?.classList.toggle('show', h.scrollTop > 1.5 * h.clientHeight);
    };
    document.addEventListener('scroll', onScroll, { passive: true }); onScroll();
    // "Back to top" links: scroll up and move keyboard focus to the start of the page
    document.querySelectorAll<HTMLAnchorElement>('a[href="#top"]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0 });
      history.replaceState(history.state, '', location.pathname + location.search);
      // keyboard activation (detail 0): continue tabbing from the top; mouse clicks just drop focus
      if ((e as MouseEvent).detail === 0) (document.querySelector('.skip') as HTMLElement | null)?.focus({ preventScroll: true });
      else (document.activeElement as HTMLElement | null)?.blur();
    }));
    // Site menu (dialog)
    const menu = document.getElementById('site-menu') as HTMLDialogElement | null;
    const mbtn = document.getElementById('menu-btn');
    const setOpen = (open: boolean) => {
      if (!menu || !mbtn) return;
      if (open && !menu.open) {
        menu.showModal();
        mbtn.setAttribute('aria-expanded', 'true');
        (menu.querySelector('.drawer-ch a[aria-current="page"]') as HTMLElement | null)?.scrollIntoView({ block: 'center' });
      } else if (!open && menu.open) menu.close();
    };
    mbtn?.addEventListener('click', () => setOpen(true));
    menu?.addEventListener('close', () => mbtn?.setAttribute('aria-expanded', 'false'));
    menu?.querySelector('[data-close]')?.addEventListener('click', () => setOpen(false));
    // click on the backdrop (outside the panel) closes the menu
    menu?.addEventListener('click', (e) => { if (e.target === menu) setOpen(false); });
    // same-page links (e.g. Home while on home) should still close the menu
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  </script>
  <style is:global>
    .skip { position: absolute; left: -999px; top: 0; z-index: 100; background: var(--accent); color: #fff; padding: .5rem 1rem; }
    .skip:focus { left: 1rem; }
    .topbar { position: sticky; top: 0; z-index: 50; height: var(--header-h); display: flex; align-items: center; gap: 1.5rem; padding: 0 1.25rem; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid var(--border); }
    .brand { display: flex; align-items: center; gap: .55rem; color: var(--text); font-weight: 600; font-size: 1.05rem; letter-spacing: -.01em; text-decoration: none !important; white-space: nowrap; }
    .brand b { font-weight: 800; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .topnav { display: flex; gap: .3rem; }
    .topnav a { color: var(--text-2); font-size: .88rem; font-weight: 550; padding: .4rem .7rem; border-radius: 8px; text-decoration: none; }
    .topnav a:hover { background: var(--surface-2); color: var(--text); }
    .topnav a[aria-current='page'] { color: var(--text); background: var(--surface-2); }
    @media (max-width: 640px) { .topnav { display: none; } }
    .top-right { margin-left: auto; display: flex; align-items: center; gap: .6rem; }
    .icon-btn { all: unset; box-sizing: border-box; cursor: pointer; width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center; border-radius: 9px; color: var(--text-2); border: 1px solid var(--border); }
    .icon-btn:hover { background: var(--surface-2); color: var(--text); }
    .icon-btn:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 2px; }
    :root[data-theme='light'] .icon-btn .sun, :root:not([data-theme='light']) .icon-btn .moon { display: none; }
    /* The menu button appears where the top nav (<=640px) or the chapter sidebar (<=1000px) is hidden. */
    .menu-btn { display: none; }
    @media (max-width: 640px) { .menu-btn { display: grid; } .topbar { gap: .75rem; padding: 0 .9rem; } }
    @media (max-width: 1000px) { .has-sidebar .menu-btn { display: grid; } .has-sidebar .topbar { gap: .9rem; } }
    @media (max-width: 400px) { .top-right { gap: .4rem; } }
    .read-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; }
    .read-progress i { display: block; height: 100%; background: var(--grad); transform-origin: left; transform: scaleX(0); }

    .drawer { margin: 0; padding: 0; border: 0; border-right: 1px solid var(--border-strong); background: var(--bg-2); color: var(--text); width: min(320px, 88vw); max-width: none; height: 100dvh; max-height: none; overflow-y: auto; box-shadow: var(--shadow); }
    .drawer[open] { animation: drawerIn .18s ease-out; }
    @keyframes drawerIn { from { transform: translateX(-100%); } to { transform: none; } }
    .drawer::backdrop { background: rgba(3, 6, 15, .55); }
    .drawer-head { position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between; padding: .8rem 1rem; background: var(--bg-2); border-bottom: 1px solid var(--border); }
    .drawer-h { margin: 0; font: 650 1rem var(--font-ui); letter-spacing: 0; }
    .drawer ul { list-style: none; margin: 0; padding: 0; }
    .drawer li { margin: 0; }
    .drawer-main { padding: .6rem .6rem .4rem; border-bottom: 1px solid var(--border); }
    .drawer a { display: flex; align-items: center; gap: .6rem; padding: .5rem .6rem; border-radius: 8px; color: var(--text-2); font-size: .92rem; text-decoration: none; }
    .drawer a:hover { background: var(--surface-2); color: var(--text); }
    .drawer a[aria-current='page'] { background: var(--surface-2); color: var(--text); font-weight: 650; }
    .drawer-ch { padding: .4rem .6rem 2rem; }
    .drawer-ph { margin: .9rem .6rem .3rem; font: 650 .78rem var(--font-ui); color: var(--muted); letter-spacing: 0; }
    .drawer-ch a[aria-current='page'] { background: color-mix(in srgb, var(--c) 16%, transparent); }
    .dn { font: 650 .76rem var(--font-ui); font-variant-numeric: tabular-nums; color: var(--c); width: 1.2rem; text-align: right; }

    .to-top { position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 40; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; background: var(--surface-2); color: var(--text); border: 1px solid var(--border-strong); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .2s, transform .2s, visibility .2s; text-decoration: none !important; }
    .to-top.show { opacity: 1; visibility: visible; transform: none; }
    .to-top:hover { border-color: var(--accent); }
    .to-top:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 2px; border-radius: 50%; }
    @media print { .to-top, .drawer, .menu-btn { display: none !important; } }

    .site-foot { margin-top: 6rem; padding: 2.5rem 1.5rem 3rem; border-top: 1px solid var(--border); font-size: .84rem; text-align: center; display: grid; gap: .4rem; color: var(--text-2); }
    .foot-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .3rem 1.4rem; margin-bottom: .6rem; font-weight: 600; }
    .foot-nav a { color: var(--text-2); }
    .foot-nav a:hover { color: var(--text); }
  </style>
</body>
</html>
