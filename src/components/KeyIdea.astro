---
// A single big takeaway, set large. <KeyIdea>Forecasts are distributions, not numbers.</KeyIdea>
interface Props { label?: string }
const { label = 'Key idea' } = Astro.props;
---
<div class="key">
  <div class="eyebrow">{label}</div>
  <div class="kt"><slot /></div>
</div>
<style>
  .key { margin: 2.4rem 0; padding: 1.4rem 1.6rem; border-radius: var(--radius); position: relative; background: var(--surface); border: 1px solid var(--border); overflow: hidden; }
  .key::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--ch, var(--accent)); }
  .kt { font-family: var(--font-display); font-size: 1.42rem; line-height: 1.4; color: var(--text); margin-top: .35rem; letter-spacing: -.01em; }
  .kt :global(p) { margin: 0; }
</style>
