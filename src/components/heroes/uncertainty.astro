---
// Signature hero for Chapter 10: many simulated futures (spaghetti) condense into a fan chart.
const W = 520, H = 340, N = 34, O = 22, NP = 22;
const season = [0, -5, 3, 1, 4, 2, 0, 3, -1, 2, 7, 19];
const y = Array.from({ length: O + 1 }, (_, t) => 100 + 1.0 * t + season[t % 12] + Math.sin(t * 2.3) * 1.6);
const x = (t: number) => 18 + (t / (N - 1)) * (W - 36);
const ys = (v: number) => H - 34 - ((v - 82) / 100) * (H - 70);
let s = 20261114 >>> 0;
const u = () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const nrm = () => Math.sqrt(-2 * Math.log(u() || 1e-9)) * Math.cos(2 * Math.PI * u());
const fut = Array.from({ length: N - O }, (_, i) => O + i);
const mean = (t: number) => y[O] + 1.0 * (t - O) + (season[t % 12] - season[O % 12]);
const paths = Array.from({ length: NP }, () => { let w = 0; return fut.map((t, i) => { if (i) w += nrm() * 2.4; return [t, mean(t) + w]; }); });
const line = (pts: number[][]) => 'M' + pts.map(([t, v]) => `${x(t).toFixed(1)},${ys(v).toFixed(1)}`).join('L');
const band = (z: number) => {
  const up = fut.map((t) => [t, mean(t) + z * Math.sqrt(t - O) * 2.4]);
  const lo = fut.map((t) => [t, mean(t) - z * Math.sqrt(t - O) * 2.4]).reverse();
  return line([...up, ...lo]) + 'Z';
};
const hist = line(y.map((v, t) => [t, v]));
const fc = line(fut.map((t) => [t, mean(t)]));
const end = fut[fut.length - 1];
---
<svg viewBox={`0 0 ${W} ${H}`} class="uh" role="img" aria-label="Many simulated future paths fading into a fan chart of 80 and 95 percent intervals">
  {[0, 1, 2, 3].map((i) => <line x1="18" x2={W - 18} y1={36 + i * ((H - 70) / 3)} y2={36 + i * ((H - 70) / 3)} stroke="var(--border)" />)}
  <path d={band(1.96)} class="band b95" />
  <path d={band(1.28)} class="band b80" />
  <g class="spag">
    {paths.map((p, i) => <path d={line([[O, y[O]], ...p])} class="pth" pathLength="1" style={`--d:${(1.15 + i * 0.05).toFixed(2)}s`} />)}
  </g>
  <path d={hist} class="ln hist" pathLength="1" />
  <path d={fc} class="ln fc" pathLength="1" />
  <line x1={x(O)} x2={x(O)} y1="24" y2={H - 26} stroke="var(--border-strong)" stroke-dasharray="3 4" />
  <text x={x(O) - 8} y="26" text-anchor="end" class="t">today</text>
  <text x={x(O) + 8} y="26" class="t lab1">{NP} possible futures…</text>
  <text x={x(O) + 8} y="26" class="t lab2">…summarized as a fan</text>
  <text x={x(end) + 4} y={ys(mean(end) + 1.96 * Math.sqrt(end - O) * 2.4) + 4} class="tt lv" text-anchor="end" dx="-4" dy="-8">95%</text>
  <text x={x(end) + 4} y={ys(mean(end) + 1.28 * Math.sqrt(end - O) * 2.4) + 4} class="tt lv" text-anchor="end" dx="-4" dy="6">80%</text>
</svg>
<style>
  .uh { max-width: 560px; }
  .ln { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s cubic-bezier(.65,0,.35,1) forwards; }
  .hist { stroke: var(--c-history); stroke-width: 2.4; }
  .fc { stroke: var(--c-forecast); stroke-width: 3; animation-delay: 2.6s; animation-duration: .6s; }
  .pth { fill: none; stroke: var(--c-forecast); stroke-width: 1.3; stroke-opacity: .55; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw .7s var(--d) cubic-bezier(.4,0,.2,1) forwards; }
  .spag { animation: settle .6s 2.5s cubic-bezier(.3,0,.8,.15) forwards; }
  .band { fill: var(--c-forecast); opacity: 0; transform-box: fill-box; transform-origin: left center; transform: scaleY(.2); animation: fan .7s 2.45s cubic-bezier(.05,.7,.1,1) forwards; }
  .b95 { --o: .14; } .b80 { --o: .26; animation-delay: 2.6s; }
  .t { font: 600 12px var(--font-ui); fill: var(--muted); }
  .tt { font: 650 12px var(--font-ui); fill: var(--text-2); }
  .lab1 { animation: out .3s 2.4s forwards; }
  .lab2, .lv { opacity: 0; animation: in .4s 2.9s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes settle { to { opacity: .22; } }
  @keyframes fan { to { opacity: var(--o); transform: scaleY(1); } }
  @keyframes in { to { opacity: 1; } }
  @keyframes out { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ln, .pth, .spag, .band, .lab1, .lab2, .lv { animation: none; stroke-dashoffset: 0; }
    .spag { opacity: .22; } .band { opacity: var(--o); transform: none; } .lab1 { opacity: 0; } .lab2, .lv { opacity: 1; }
  }
</style>
