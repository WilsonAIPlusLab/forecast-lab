---
// Signature hero for Chapter 13: a wall of 20 ragged-edged sparklines collapses into one common factor,
// which then runs past the ragged edge to a "nowcast" dot for the month nobody has measured yet.
const W = 520, N = 60;
const P = { x: 24, y: 236, w: 430, h: 128 }; // panel where everything ends up
// seeded PRNG so the art is identical on every build
let seed = 13;
const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
const gauss = () => { let a = 0; for (let i = 0; i < 6; i++) a += rnd(); return a - 3; };
const dip = (t: number, c: number, w: number, d: number) => -d * Math.exp(-(((t - c) / w) ** 2));
const factor = Array.from({ length: N }, (_, t) => 0.25 * Math.sin(t / 5) + dip(t, 17, 3.2, 2.2) + dip(t, 44, 2.6, 2.8));
const recessions = [[13, 20], [41, 47]];
const fx = (t: number) => P.x + (t / (N - 1)) * P.w;
const fy = (v: number) => P.y + P.h * 0.42 - v * (P.h * 0.19);
const COLS = 5, ROWS = 4, gx = 24, gy = 22, cw = 86, ch = 36, gapx = 8, gapy = 10;
const tiles = Array.from({ length: COLS * ROWS }, (_, i) => {
  const load = (0.55 + 0.45 * rnd()) * (i % 7 === 3 || i % 7 === 5 ? -1 : 1);
  const end = N - 1 - Math.floor(rnd() * 8); // ragged edge: each series stops at a different month
  const y = factor.map((f) => load * f + 0.55 * gauss());
  const d = y.slice(0, end + 1).map((v, t) => `${t ? 'L' : 'M'}${fx(t).toFixed(1)},${fy(v).toFixed(1)}`).join('');
  const col = i % COLS, row = Math.floor(i / COLS);
  const cx = gx + col * (cw + gapx), cy = gy + row * (ch + gapy);
  const sx = cw / P.w, sy = ch / P.h;
  return { d, neg: load < 0, cx, cy, tx: cx - P.x * sx, ty: cy - P.y * sy, sx, sy, delay: 0.04 * i };
});
const fac = factor.map((v, t) => `${t ? 'L' : 'M'}${fx(t).toFixed(1)},${fy(v).toFixed(1)}`).join('');
const edgeA = fx(N - 8), edgeB = fx(N - 1);
const nowX = fx(N - 1) + 34, nowY = fy(factor[N - 1] + 0.15);
---
<svg viewBox={`0 0 ${W} 400`} class="nh" role="img" aria-label="Twenty small indicator charts collapse into one common factor line that extends past the ragged edge of the data to a nowcast">
  <g class="ghosts">
    {tiles.map((t) => <rect x={t.cx} y={t.cy} width={cw} height={ch} rx="5" />)}
  </g>
  <text x={gx} y="14" class="lbl">20 indicators, each released on its own schedule</text>
  <g class="panel">
    {recessions.map(([a, b]) => <rect x={fx(a)} y={P.y - 8} width={fx(b) - fx(a)} height={P.h + 4} class="rec" />)}
    <line x1={P.x} x2={nowX + 10} y1={fy(0)} y2={fy(0)} class="zero" />
  </g>
  {tiles.map((t) => (
    <path d={t.d} class:list={['sp', { neg: t.neg }]} pathLength="1"
      style={`--tx:${t.tx.toFixed(1)}px;--ty:${t.ty.toFixed(1)}px;--sx:${t.sx.toFixed(4)};--sy:${t.sy.toFixed(4)};--dl:${t.delay.toFixed(2)}s`} />
  ))}
  <path d={`M${edgeA},${P.y - 10} v-5 H${edgeB} v5`} class="edge" />
  <text x={edgeB} y={P.y - 20} class="lbl end edge-l">ragged edge</text>
  <path d={fac} class="fac" pathLength="1" />
  <path d={`M${fx(N - 1).toFixed(1)},${fy(factor[N - 1]).toFixed(1)} L${nowX},${nowY}`} class="bridge" />
  <circle cx={nowX} cy={nowY} r="6.5" class="now" />
  <circle cx={nowX} cy={nowY} r="14" class="nowband" />
  <text x={nowX} y={nowY - 22} class="lbl now-l">nowcast</text>
  <text x={P.x} y={P.y + P.h + 26} class="cap">one common factor</text>
</svg>
<style>
  .nh { max-width: 560px; }
  .lbl { font: 600 13px var(--font-ui); fill: var(--muted); }
  .lbl.end { text-anchor: end; }
  .cap { font: 650 14px var(--font-ui); fill: var(--c-fitted); opacity: 0; animation: fade .5s 2.9s forwards; }
  .ghosts rect { fill: color-mix(in srgb, var(--surface) 70%, transparent); stroke: var(--border); }
  .rec { fill: var(--muted); opacity: 0; animation: fadeTo .5s 2.2s forwards; --o: .14; }
  .zero { stroke: var(--border-strong); stroke-width: 1; opacity: 0; animation: fadeTo .4s 2.2s forwards; --o: 1; }
  .sp { fill: none; stroke: var(--c-history); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1; transform-box: view-box; transform-origin: 0 0;
    transform: translate(var(--tx), var(--ty)) scale(var(--sx), var(--sy));
    animation: draw .9s var(--dl) cubic-bezier(.65, 0, .35, 1) forwards, collapse .8s calc(1.35s + var(--dl) * .5) cubic-bezier(.2, 0, 0, 1) forwards; }
  .sp.neg { stroke: var(--c-s2); }
  .edge { fill: none; stroke: var(--border-strong); stroke-width: 1.5; opacity: 0; animation: fadeTo .4s 2.4s forwards; --o: 1; }
  .fac { fill: none; stroke: var(--c-fitted); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 1s 2.3s cubic-bezier(.65, 0, .35, 1) forwards; filter: drop-shadow(0 0 6px color-mix(in srgb, var(--c-fitted) 45%, transparent)); }
  .edge-l { opacity: 0; animation: fade .4s 2.4s forwards; }
  .bridge { fill: none; stroke: var(--c-forecast); stroke-width: 2.4; stroke-dasharray: 4 4; opacity: 0; animation: fadeTo .4s 3.2s forwards; --o: 1; }
  .now { fill: var(--c-forecast); opacity: 0; animation: fadeTo .3s 3.4s forwards; --o: 1; }
  .nowband { fill: var(--c-forecast); opacity: 0; animation: fadeTo .4s 3.4s forwards; --o: .18; }
  .now-l { text-anchor: middle; fill: var(--accent-text); opacity: 0; animation: fade .3s 3.5s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes collapse { to { transform: translate(0, 0) scale(1, 1); opacity: .28; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes fadeTo { to { opacity: var(--o); } }
  @media (prefers-reduced-motion: reduce) {
    .sp, .fac, .rec, .zero, .edge, .edge-l, .bridge, .now, .nowband, .now-l, .cap { animation: none; stroke-dashoffset: 0; }
    .sp { transform: none; opacity: .28; }
    .rec { opacity: .14; } .zero, .edge, .edge-l, .bridge, .now, .now-l, .cap { opacity: 1; } .nowband { opacity: .18; }
  }
</style>
