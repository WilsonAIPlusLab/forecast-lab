---
// Signature hero for Chapter 8: inverted jobless claims (real data) slide 7 months to the right
// and land on top of payroll job growth. Below, the real cross-correlation bars with the peak at a 7-month lead.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const read = (id: string) => readFileSync(join(process.cwd(), 'public', 'data', `${id}.csv`), 'utf8').trim().split('\n').slice(1)
  .map((l) => { const [d, v] = l.split(','); return { k: d.slice(0, 7), v: parseFloat(v) }; }).filter((p) => Number.isFinite(p.v));
const monthly = (rows: { k: string; v: number }[]) => {
  const m = new Map<string, number[]>();
  for (const r of rows) (m.get(r.k) || m.set(r.k, []).get(r.k)!).push(r.v);
  return [...m].map(([k, v]) => ({ k, v: v.reduce((a, b) => a + b, 0) / v.length }));
};
const yoy = (rows: { k: string; v: number }[]) => rows.slice(12).map((r, i) => ({ k: r.k, v: 100 * Math.log(r.v / rows[i].v) }));
const jobs = yoy(read('PAYEMS')).filter((r) => r.k >= '1990-01' && r.k <= '2019-12');
const claims = yoy(monthly(read('ICSA'))).filter((r) => r.k >= '1990-01' && r.k <= '2019-12');
const z = (v: number[]) => { const m = v.reduce((a, b) => a + b, 0) / v.length; const s = Math.sqrt(v.reduce((a, b) => a + (b - m) ** 2, 0) / (v.length - 1)); return v.map((x) => (x - m) / s); };
const zj = z(jobs.map((r) => r.v)), zc = z(claims.map((r) => r.v)).map((v) => -v);
// cross-correlation (R ccf convention), leads 0..18
const n = jobs.length, xs = claims.map((r) => r.v), ys = jobs.map((r) => r.v);
const mx = xs.reduce((a, b) => a + b, 0) / n, my = ys.reduce((a, b) => a + b, 0) / n;
const sx = Math.sqrt(xs.reduce((a, b) => a + (b - mx) ** 2, 0) / n), sy = Math.sqrt(ys.reduce((a, b) => a + (b - my) ** 2, 0) / n);
const cc = Array.from({ length: 19 }, (_, L) => { let s = 0; for (let t = L; t < n; t++) s += (xs[t - L] - mx) * (ys[t] - my); return { L, r: -s / n / (sx * sy) }; });
const best = cc.reduce((a, b) => (b.r > a.r ? b : a));

// drawing window: 2003-2012, around the Great Recession, so the 7-month slide is clearly visible
const W = 520, H = 250, x0 = 20, x1 = W - 20;
const from = jobs.findIndex((r) => r.k === '2003-01'), to = jobs.findIndex((r) => r.k === '2012-12');
const span = to - from;
const px = (i: number) => x0 + ((i - from) / span) * (x1 - x0);
const win = [...zj.slice(from, to + 1), ...zc.slice(from, to + 1)];
const vmin = Math.min(...win), vmax = Math.max(...win);
const py = (v: number) => 30 + ((vmax - v) / (vmax - vmin)) * (H - 70);
const path = (vals: number[], a: number, b: number) => vals.slice(a, b + 1).map((v, j) => `${j ? 'L' : 'M'}${px(a + j).toFixed(1)},${py(v).toFixed(1)}`).join('');
const jobPath = path(zj, from, to);
const claimPath = path(zc, from, to - best.L); // drawn at its true dates; it will slide right by `best.L` months
const dx = (px(from + best.L) - px(from)).toFixed(1);
const recs = [['2007-12', '2009-06']].map(([a, b]) => ({ a: px(jobs.findIndex((r) => r.k === a)), b: px(jobs.findIndex((r) => r.k === b)) }));
const years = [2004, 2006, 2008, 2010, 2012].map((y) => ({ y, x: px(jobs.findIndex((r) => r.k === `${y}-01`)) }));
const bw = (x1 - x0) / 19;
---
<svg viewBox={`0 0 ${W} ${H + 130}`} class="dr" role="img" aria-label="Inverted jobless claims slide seven months later and line up with payroll job growth">
  {recs.map((r) => <rect x={r.a} y="18" width={r.b - r.a} height={H - 40} class="rec" />)}
  <text x={recs[0].a + 4} y="30" class="lbl">Recession</text>
  <line x1={x0} x2={x1} y1={py(0)} y2={py(0)} class="zero" />
  {years.map((t) => <text x={t.x} y={H - 6} class="yr">{t.y}</text>)}
  <path d={jobPath} class="ln jobs" pathLength="1" />
  <g class="slide" style={`--dx:${dx}px`}>
    <path d={claimPath} class="ln claims" pathLength="1" />
  </g>
  <text x={x0 + 2} y="12" class="key"><tspan class="kc">━ jobless claims, inverted</tspan><tspan dx="14" class="kj">━ payroll job growth</tspan></text>
  <g class="tag" transform={`translate(${px(jobs.findIndex((r) => r.k === '2010-06'))}, ${H - 26})`}>
    <line x1="0" x2={dx} y1="0" y2="0" class="arrow" />
    <path d={`M${dx},0 l-6,-4 v8 z`} class="arrowhead" />
    <text x={Number(dx) / 2} y="-6" class="lead">{best.L}-month lead</text>
  </g>
  <g transform={`translate(0, ${H + 18})`}>
    <text x={x0} y="0" class="lbl">Correlation with job growth (claims inverted), by months claims move first</text>
    {cc.map((c, i) => (
      <g>
        <rect x={x0 + i * bw + 2} y={86 - Math.max(0, c.r) * 80} width={bw - 4} height={Math.max(0, c.r) * 80} rx="2" class:list={['bar', { best: c.L === best.L }]} style={`--d:${2.6 + i * 0.03}s`} />
        {(c.L % 6 === 0 || c.L === best.L) && <text x={x0 + i * bw + bw / 2} y="100" class:list={['tick', { tb: c.L === best.L }]}>{c.L}</text>}
      </g>
    ))}
  </g>
</svg>
<style>
  .dr { max-width: 560px; }
  .rec { fill: var(--muted); opacity: .13; }
  .zero { stroke: var(--border-strong); stroke-width: 1; }
  .lbl { font: 600 12px var(--font-ui); fill: var(--muted); }
  .yr, .tick { font: 500 12px var(--font-ui); fill: var(--muted); text-anchor: middle; }
  .tick.tb { fill: var(--ch, #fb923c); font-weight: 700; }
  .key { font: 600 12px var(--font-ui); }
  .kc { fill: var(--ch, #fb923c); } .kj { fill: var(--c-history); }
  .ln { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s cubic-bezier(.65,0,.35,1) forwards; }
  .jobs { stroke: var(--c-history); stroke-width: 2.2; }
  .claims { stroke: var(--ch, #fb923c); stroke-width: 2.4; animation-delay: .5s; }
  .slide { transform: translateX(0); animation: slide .9s 1.7s cubic-bezier(.2,0,0,1) forwards; }
  .tag { opacity: 0; animation: fade .4s 2.5s forwards; }
  .arrow { stroke: var(--text-2); stroke-width: 1.5; }
  .arrowhead { fill: var(--text-2); }
  .lead { font: 700 12px var(--font-ui); fill: var(--text); text-anchor: middle; }
  .bar { fill: var(--c-s1); opacity: .45; transform-box: fill-box; transform-origin: bottom; transform: scaleY(0); animation: grow .5s var(--d) cubic-bezier(.2,.8,.2,1) forwards; }
  .bar.best { fill: var(--ch, #fb923c); opacity: 1; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes slide { to { transform: translateX(var(--dx)); } }
  @keyframes grow { to { transform: scaleY(1); } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .ln, .bar, .tag, .slide { animation: none; }
    .ln { stroke-dashoffset: 0; } .bar { transform: none; } .tag { opacity: 1; } .slide { transform: translateX(var(--dx)); }
  }
</style>
