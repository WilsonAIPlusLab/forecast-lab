---
// Signature hero for Chapter 0: a forecast fan unfolding out of history, like the one students build.
const W = 520, H = 340, N = 40, O = 28;
const season = [0, -4, 3, 1, 4, 2, 0, 3, -1, 2, 6, 18];
const y = Array.from({ length: N }, (_, t) => 100 + 1.1 * t + season[t % 12] + Math.sin(t * 2.1) * 1.8);
const x = (t: number) => 18 + (t / (N - 1)) * (W - 36);
const ys = (v: number) => H - 30 - ((v - 88) / 85) * (H - 60);
const fut = Array.from({ length: N - O }, (_, i) => O + i);
const mean = (t: number) => y[O] + 1.1 * (t - O) + (season[t % 12] - season[O % 12]);
const band = (z: number) => {
  const up = fut.map((t) => [x(t), ys(mean(t) + z * Math.sqrt(t - O) * 2.6)]);
  const lo = fut.map((t) => [x(t), ys(mean(t) - z * Math.sqrt(t - O) * 2.6)]).reverse();
  return 'M' + [...up, ...lo].map((p) => p.map((v) => v.toFixed(1)).join(',')).join('L') + 'Z';
};
const line = (pts: number[][]) => 'M' + pts.map((p) => p.map((v) => v.toFixed(1)).join(',')).join('L');
const hist = line(y.slice(0, O + 1).map((v, t) => [x(t), ys(v)]));
const fc = line(fut.map((t) => [x(t), ys(mean(t))]));
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A forecast fan chart">
  <defs>
    <linearGradient id="ff-g" x1="0" x2="1"><stop offset="0" stop-color="var(--c-band)" stop-opacity=".55" /><stop offset="1" stop-color="var(--c-band)" stop-opacity=".15" /></linearGradient>
  </defs>
  {[0, 1, 2, 3, 4].map((i) => <line x1="18" x2={W - 18} y1={30 + i * ((H - 60) / 4)} y2={30 + i * ((H - 60) / 4)} stroke="var(--border)" />)}
  <path d={band(1.96)} fill="url(#ff-g)" opacity=".45" class="band b2" />
  <path d={band(1.28)} fill="url(#ff-g)" opacity=".75" class="band b1" />
  <path d={hist} class="ln" stroke="var(--c-history)" pathLength="1" />
  <path d={fc} class="ln fc" stroke="var(--c-forecast)" pathLength="1" />
  <line x1={x(O)} x2={x(O)} y1="22" y2={H - 24} stroke="var(--border-strong)" stroke-dasharray="3 4" />
  <text x={x(O) + 8} y="22" class="t">forecast →</text>
  <circle cx={x(O)} cy={ys(y[O])} r="5" fill="var(--c-forecast)" class="dot" />
  <g class="tag" transform={`translate(${x(N - 1) - 118}, ${ys(mean(N - 1) + 1.96 * Math.sqrt(N - 1 - O) * 2.6) - 34})`}>
    <rect width="118" height="24" rx="12" fill="var(--surface-3)" stroke="var(--border-strong)" />
    <text x="59" y="16" text-anchor="middle" class="tt">95% interval</text>
  </g>
</svg>
<style>
  svg { max-width: 560px; }
  .ln { fill: none; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s cubic-bezier(.65,0,.35,1) forwards; }
  .fc { stroke-width: 3; animation-delay: 1.5s; animation-duration: 1s; }
  .band { transform-box: fill-box; transform-origin: left center; transform: scaleX(0); animation: grow 1.1s 1.7s cubic-bezier(.2,.8,.2,1) forwards; }
  .b2 { animation-delay: 1.9s; }
  .dot { opacity: 0; animation: pop .4s 1.45s forwards, breathe 2.4s 2s infinite; }
  .tag { opacity: 0; animation: pop .5s 2.9s forwards; }
  .t { font: 600 12px var(--font-ui); fill: var(--muted); }
  .tt { font: 600 12px var(--font-ui); fill: var(--text-2); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes grow { to { transform: scaleX(1); } }
  @keyframes pop { to { opacity: 1; } }
  @keyframes breathe { 50% { r: 8; opacity: .6; } }
  @media (prefers-reduced-motion: reduce) { .ln, .band, .dot, .tag { animation: none; stroke-dashoffset: 0; transform: none; opacity: 1; } }
</style>
