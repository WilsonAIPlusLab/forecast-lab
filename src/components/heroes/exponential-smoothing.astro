---
// Signature hero for Chapter 6: exponentially decaying weights on past months feed a smooth level,
// which becomes the forecast. Built from a deterministic noisy series smoothed with alpha = 0.3.
const W = 520, N = 34, A = 0.3, K = 14; // N observations, show K weight bars
const x0 = 28, x1 = 400;
const x = (t: number) => x0 + (t / (N - 1)) * (x1 - x0);
const level = (t: number) => 100 + 10 * Math.sin(t / 7) + 0.35 * t;
const noise = (t: number) => 9 * Math.sin(t * 2.3 + 1) * Math.cos(t * 0.9) + 4 * Math.sin(t * 5.1);
const y = Array.from({ length: N }, (_, t) => level(t) + noise(t));
let l = y[0];
const fit: number[] = [];
for (const v of y) { l = A * v + (1 - A) * l; fit.push(l); }
const lo = 84, hi = 128, top = 34, bot = 196;
const ys = (v: number) => bot - ((v - lo) / (hi - lo)) * (bot - top);
const fitPath = fit.map((v, t) => `${t ? 'L' : 'M'}${x(t).toFixed(1)},${ys(v).toFixed(1)}`).join('');
const fcY = ys(fit[N - 1]);
const fcPath = `M${x(N - 1).toFixed(1)},${fcY.toFixed(1)}L${(W - 26).toFixed(1)},${fcY.toFixed(1)}`;
// weight bars under the last K observations
const bBase = 330, bMax = 96;
const bars = Array.from({ length: K }, (_, j) => {
  const t = N - 1 - j, w = A * (1 - A) ** j;
  return { x: x(t), h: (w / A) * bMax, w, j, delay: 1.25 + j * 0.06 };
});
const bw = ((x1 - x0) / (N - 1)) * 0.62;
---
<svg viewBox={`0 0 ${W} 372`} class="esh" role="img" aria-label="Past observations receive exponentially decaying weights; their weighted average is the smoothed level, which becomes a flat forecast">
  <text x={x0} y="20" class="lbl">Past months</text>
  <text x={x(N - 1) + 10} y="20" class="lbl">Forecast</text>
  <line x1={x(N - 1)} x2={x(N - 1)} y1="26" y2={bBase} stroke="var(--border-strong)" stroke-dasharray="3 4" />
  {y.map((v, t) => <circle cx={x(t)} cy={ys(v)} r="3.2" class="dot" style={`--d:${(t * 0.018).toFixed(3)}s`} />)}
  {bars.map((b) => (
    <line x1={b.x} x2={b.x} y1={ys(y[N - 1 - b.j]) + 6} y2={bBase - b.h - 4} class="guide" style={`--d:${b.delay + 0.25}s;--o:${(0.15 + 0.55 * (b.w / A)).toFixed(2)}`} />
  ))}
  <path d={fitPath} class="fit" pathLength="1" />
  <path d={fcPath} class="fc" pathLength="1" />
  <circle cx={x(N - 1)} cy={fcY} r="5" class="knot" />
  <text x={W - 26} y={fcY - 10} class="fcl" text-anchor="end">flat forecast</text>
  <g>
    {bars.map((b) => (
      <rect x={b.x - bw / 2} y={bBase - b.h} width={bw} height={b.h} rx="2" class="esh-bar" style={`--d:${b.delay}s;--o:${(0.35 + 0.65 * (b.w / A)).toFixed(2)}`} />
    ))}
    <line x1={x0} x2={x1 + 8} y1={bBase} y2={bBase} stroke="var(--border-strong)" />
    <text x={x(N - 1) + 10} y={bBase - bMax + 10} class="wl">α = 0.3</text>
    <text x={x(N - 1) + 10} y={bBase - bMax + 28} class="ws">this month</text>
    <text x={x(N - K) - 8} y={bBase - 8} class="ws" text-anchor="end">13 months back:</text>
    <text x={x(N - K) - 8} y={bBase + 6} class="ws" text-anchor="end">weight ≈ 0.3%</text>
    <text x={x0} y={bBase + 28} class="lbl">Weight each month gets: α(1 − α)ʲ</text>
  </g>
</svg>
<style>
  .esh { max-width: 560px; }
  .lbl { font: 700 12px var(--font-ui); fill: var(--muted); }
  .dot { fill: var(--c-history); opacity: 0; animation: esh-pop .35s var(--d) ease-out forwards; }
  .fit { fill: none; stroke: var(--c-fitted); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: esh-draw 1.3s .55s cubic-bezier(.65,0,.35,1) forwards; }
  .fc { fill: none; stroke: var(--c-forecast); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; animation: esh-draw .7s 2.55s cubic-bezier(.2,.8,.2,1) forwards; }
  .knot { fill: var(--c-forecast); opacity: 0; animation: esh-pop .3s 2.4s forwards; }
  .fcl { font: 600 12px var(--font-ui); fill: var(--c-forecast); opacity: 0; animation: esh-fade .4s 3s forwards; }
  .esh-bar { fill: var(--c-fitted); opacity: 0; transform-box: fill-box; transform-origin: bottom; transform: scaleY(0); animation: esh-grow .5s var(--d) cubic-bezier(.2,.8,.2,1) forwards; }
  .guide { stroke: var(--c-fitted); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0; animation: esh-fadeo .4s var(--d) forwards; }
  .wl { font: 650 13px var(--font-ui); fill: var(--text); }
  .ws { font: 500 12px var(--font-ui); fill: var(--muted); }
  @keyframes esh-draw { to { stroke-dashoffset: 0; } }
  @keyframes esh-pop { to { opacity: .85; } }
  @keyframes esh-fade { to { opacity: 1; } }
  @keyframes esh-fadeo { to { opacity: var(--o); } }
  @keyframes esh-grow { to { transform: scaleY(1); opacity: var(--o); } }
  @media (prefers-reduced-motion: reduce) {
    .dot, .fit, .fc, .knot, .fcl, .esh-bar, .guide { animation: none; stroke-dashoffset: 0; transform: none; }
    .dot { opacity: .85; } .knot, .fcl { opacity: 1; } .esh-bar, .guide { opacity: var(--o); }
  }
</style>
