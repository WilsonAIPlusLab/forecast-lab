---
// Signature hero for Chapter 7: the same shocks fed through phi = 0.8 (they fade) and phi = 1 (they pile up).
const W = 520, X0 = 44, X1 = 470, H = 60, NP = 16, U = 4.8, Y0 = 3;
let s = 20261114 >>> 0;
const u = () => { s = (s + 0x6d2b79f5) >>> 0; let t = s; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const norm = () => Math.sqrt(-2 * Math.log(u() || 1e-9)) * Math.cos(2 * Math.PI * u());
const shocks = Array.from({ length: NP }, () => Array.from({ length: H }, norm));
const sim = (phi: number) => shocks.map((e) => { const y = [Y0]; for (let t = 1; t <= H; t++) y.push(phi * y[t - 1] + e[t - 1]); return y; });
const x = (h: number) => X0 + (h / H) * (X1 - X0);
const lanes = [
  { key: 'mr', phi: 0.8, cy: 92, label: 'φ = 0.8: shocks fade, the band levels off', col: 'var(--c-fitted)' },
  { key: 'rw', phi: 1, cy: 268, label: 'φ = 1: shocks pile up, the band never stops widening', col: 'var(--c-forecast)' },
].map((l) => {
  const paths = sim(l.phi).map((p) => p.map((v, h) => `${h ? 'L' : 'M'}${x(h).toFixed(1)},${(l.cy - Math.max(-17, Math.min(17, v)) * U).toFixed(1)}`).join(''));
  const sd = (h: number) => { let a = 0; for (let j = 0; j < h; j++) a += l.phi ** (2 * j); return Math.sqrt(a); };
  const up: string[] = [], lo: string[] = [];
  for (let h = 0; h <= H; h++) { const m = Y0 * l.phi ** h, b = 1.96 * sd(h); up.push(`${x(h).toFixed(1)},${(l.cy - (m + b) * U).toFixed(1)}`); lo.unshift(`${x(h).toFixed(1)},${(l.cy - (m - b) * U).toFixed(1)}`); }
  const mean = Array.from({ length: H + 1 }, (_, h) => `${h ? 'L' : 'M'}${x(h).toFixed(1)},${(l.cy - Y0 * l.phi ** h * U).toFixed(1)}`).join('');
  return { ...l, paths, band: `M${up.join('L')}L${lo.join('L')}Z`, mean };
});
---
<svg viewBox={`0 0 ${W} 380`} class="ah" role="img" aria-label="Sixteen simulated paths with the same shocks: with phi 0.8 they stay in a narrow band around the mean; with phi 1 they spread out in a widening trumpet">
  {lanes.map((l, li) => (
    <g class="lane" style={`--c:${l.col}`}>
      <line x1={X0} x2={X1} y1={l.cy} y2={l.cy} class="mean0" />
      <path d={l.band} class="band" style={`--d:${2.1 + li * 0.25}s`} />
      {l.paths.map((d, i) => <path d={d} class={i === 0 ? 'p hi' : 'p'} pathLength="1" style={`--d:${0.25 + li * 0.35 + i * 0.07}s`} />)}
      <path d={l.mean} class="fc" pathLength="1" style={`--d:${2.3 + li * 0.25}s`} />
      <circle cx={X0} cy={l.cy - Y0 * U} r="4.5" class="o" />
      <text x={X0} y={l.cy - (li ? 96 : 56)} class="lbl" style={`--d:${2.6 + li * 0.25}s`}>{l.label}</text>
    </g>
  ))}
  <text x={X1} y="372" class="ax" text-anchor="end">Same 16 shock sequences in both panels, 60 months each</text>
</svg>
<style>
  .ah { max-width: 560px; }
  .mean0 { stroke: var(--border-strong); stroke-dasharray: 3 4; }
  .band { fill: var(--c); opacity: 0; animation: fade .7s var(--d) forwards; }
  .p { fill: none; stroke: var(--c); stroke-width: 1.15; stroke-opacity: .45; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s var(--d) cubic-bezier(.4,0,.2,1) forwards; }
  .p.hi { stroke: var(--c-actual); stroke-width: 2.4; stroke-opacity: 1; }
  .fc { fill: none; stroke: var(--text); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw .9s var(--d) cubic-bezier(.2,0,0,1) forwards; }
  .o { fill: var(--c-actual); stroke: var(--bg); stroke-width: 2; }
  .lbl { font: 600 13px var(--font-ui); fill: var(--c); opacity: 0; animation: fadeT .5s var(--d) forwards; }
  .ax { font: 500 12px var(--font-ui); fill: var(--muted); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: .14; } }
  @keyframes fadeT { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .p, .fc { animation: none; stroke-dashoffset: 0; }
    .band { animation: none; opacity: .14; }
    .lbl { animation: none; opacity: 1; }
  }
</style>
