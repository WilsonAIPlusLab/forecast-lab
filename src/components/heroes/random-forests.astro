---
// Signature hero for Chapter 12: a decision tree grows sideways out of the forecast origin; each leaf
// becomes one tree's forecast path, and the bold average of the paths is the random forest's forecast.
const W = 520, H = 340;
const O = 300;                       // x of the forecast origin
const season = [0, -5, 4, 1, 5, 2, 1, 3, -1, 2, 7, 22];
const N = 30;                        // history points
const xh = (t: number) => 18 + (t / (N - 1)) * (O - 18);
const val = (t: number) => 220 - (1.6 * t + season[(t + 2) % 12] * 2.4 + Math.sin(t * 1.9) * 3) * 0.9;
const hist = Array.from({ length: N }, (_, t) => [xh(t), val(t)] as [number, number]);
const [ox, oy] = hist[N - 1];
const d = (pts: [number, number][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join('');
// sideways tree: root at origin, 3 levels -> 8 leaves
const lv = [O + 26, O + 58, O + 90];
const spread = [56, 28, 14];
type Nd = { x: number; y: number; depth: number; px: number; py: number };
const nodes: Nd[] = [];
const grow = (x: number, y: number, depth: number, px: number, py: number) => {
  nodes.push({ x, y, depth, px, py });
  if (depth === 3) return;
  for (const s of [-1, 1]) grow(lv[depth], y + s * spread[depth], depth + 1, x, y);
};
grow(ox, oy, 0, ox, oy);
const leaves = nodes.filter((n) => n.depth === 3);
// each leaf continues as one tree's forecast: a gently seasonal path that drifts toward its leaf
const F0 = lv[2], F1 = W - 22, M = 9;
const path = (y0: number, k: number) => Array.from({ length: M }, (_, j) => {
  const x = F0 + (j / (M - 1)) * (F1 - F0);
  const pull = y0 + (oy - 20 - y0) * (j / (M - 1)) * 0.55;
  return [x, pull + Math.sin(j * 1.4 + k) * 5 - (j === M - 2 ? 14 : 0)] as [number, number];
});
const paths = leaves.map((l, k) => path(l.y, k));
const avg = Array.from({ length: M }, (_, j) => [paths[0][j][0], paths.reduce((s, p) => s + p[j][1], 0) / paths.length] as [number, number]);
const elbow = (n: Nd) => `M${n.px},${n.py} H${(n.px + n.x) / 2} V${n.y} H${n.x}`;
---
<svg viewBox={`0 0 ${W} ${H}`} class="rf" role="img" aria-label="A decision tree grows out of the forecast origin; each leaf extends into one tree's forecast, and the bold line is their average, the random forest's forecast">
  {[0, 1, 2, 3].map((i) => <line x1="18" x2={W - 18} y1={46 + i * 76} y2={46 + i * 76} stroke="var(--border)" />)}
  <line x1={ox} x2={ox} y1="26" y2={H - 18} stroke="var(--border-strong)" stroke-dasharray="3 4" />
  <text x="20" y="24" class="lbl">past months: the training rows</text>
  <text x={ox + 8} y="24" class="lbl">each leaf, one opinion</text>
  <path d={d(hist)} class="ln hist" pathLength="1" />
  {nodes.filter((n) => n.depth > 0).map((n) => (
    <path d={elbow(n)} class="br" style={`--d:${0.9 + (n.depth - 1) * 0.32}s`} pathLength="1" />
  ))}
  {nodes.filter((n) => n.depth < 3).map((n) => (
    <rect x={n.x - 4} y={n.y - 4} width="8" height="8" rx="2" class="nd" style={`--d:${0.85 + n.depth * 0.32}s`} />
  ))}
  {leaves.map((l, k) => <circle cx={l.x} cy={l.y} r="4.2" class="lf" style={`--d:${1.85 + k * 0.03}s`} />)}
  {paths.map((p, k) => <path d={d([[leaves[k].x, leaves[k].y], ...p])} class="ln op" style={`--d:${2.1 + k * 0.05}s`} pathLength="1" />)}
  <path d={d([[ox, oy], [F0, avg[0][1]], ...avg])} class="ln avg" pathLength="1" />
  <text x={F1} y={avg[M - 1][1] - 12} text-anchor="end" class="al">forest = average</text>
  <circle cx={ox} cy={oy} r="5" class="org" />
</svg>
<style>
  .rf { max-width: 560px; }
  .lbl { font: 600 12px var(--font-ui); fill: var(--muted); }
  .al { font: 700 12.5px var(--font-ui); fill: var(--c-forecast); opacity: 0; animation: fade .4s 3.1s forwards; }
  .ln { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1s cubic-bezier(.65,0,.35,1) forwards; }
  .hist { stroke: var(--c-history); stroke-width: 2.2; animation-duration: .9s; }
  .br { fill: none; stroke: var(--ch, var(--c-s3)); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw .45s var(--d) ease-out forwards; }
  .nd { fill: var(--surface); stroke: var(--ch, var(--c-s3)); stroke-width: 1.8; opacity: 0; animation: fade .2s var(--d) forwards; }
  .lf { fill: var(--ch, var(--c-s3)); opacity: 0; animation: fade .25s var(--d) forwards; }
  .op { stroke: var(--c-s5); stroke-width: 1.4; stroke-opacity: .5; animation-duration: .8s; animation-delay: var(--d); }
  .avg { stroke: var(--c-forecast); stroke-width: 3.2; animation-duration: .9s; animation-delay: 2.6s; }
  .org { fill: var(--c-history); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ln, .br, .nd, .lf, .al { animation: none; stroke-dashoffset: 0; opacity: 1; } }
</style>
