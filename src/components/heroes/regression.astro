---
// Signature hero for Chapter 4: squared residuals around a flat "mean" line shrink as the line
// rotates (about the point of means) into the least-squares line. Real data, read at build time:
// annual averages of housing starts (HOUST) and the 30-year mortgage rate (MORTGAGE30US), 1993–2007.
import fs from 'node:fs';
import path from 'node:path';

const read = (id: string) => fs.readFileSync(path.join(process.cwd(), 'public', 'data', `${id}.csv`), 'utf8').trim().split('\n').slice(1)
  .map((l) => l.split(',')).filter((r) => r[1] && r[1] !== '.').map((r) => ({ y: +r[0].slice(0, 4), v: +r[1] }));
const annual = (rows: { y: number; v: number }[]) => {
  const m = new Map<number, number[]>();
  for (const r of rows) if (r.y >= 1993 && r.y <= 2007) (m.get(r.y) || m.set(r.y, []).get(r.y)!).push(r.v);
  return new Map([...m].map(([k, v]) => [k, v.reduce((a, b) => a + b, 0) / v.length]));
};
const hs = annual(read('HOUST')), mr = annual(read('MORTGAGE30US'));
const pts = [...hs.keys()].sort().map((yr) => ({ yr, x: mr.get(yr)!, y: hs.get(yr)! }));
const n = pts.length, mx = pts.reduce((s, p) => s + p.x, 0) / n, my = pts.reduce((s, p) => s + p.y, 0) / n;
const b1 = pts.reduce((s, p) => s + (p.x - mx) * (p.y - my), 0) / pts.reduce((s, p) => s + (p.x - mx) ** 2, 0);
const b0 = my - b1 * mx;
const sst = pts.reduce((s, p) => s + (p.y - my) ** 2, 0), sse = pts.reduce((s, p) => s + (p.y - b0 - b1 * p.x) ** 2, 0);

const W = 520, H = 300, L = 46, R = 20, T = 18, B = 34;
const X0 = 5.4, X1 = 8.8, Y0 = 1100, Y1 = 2250;
const sx = (x: number) => L + ((x - X0) / (X1 - X0)) * (W - L - R);
const sy = (y: number) => H - B - ((y - Y0) / (Y1 - Y0)) * (H - T - B);
const cx = sx(mx), cy = sy(my);
const angle = (Math.atan2(sy(b0 + b1 * X1) - sy(b0 + b1 * X0), sx(X1) - sx(X0)) * 180) / Math.PI;
const sq = (p: { x: number; y: number }, fy: number) => { const s = Math.abs(sy(p.y) - sy(fy)); return { x: sx(p.x), y: Math.min(sy(p.y), sy(fy)), s }; };
const barW = W - L - R - 150;
---
<svg viewBox={`0 0 ${W} ${H + 92}`} class="rh" role="img" aria-label="Housing starts against mortgage rates, 1993 to 2007: squared errors shrink as a flat line rotates into the least-squares line">
  <g class="grid">
    {[1200, 1500, 1800, 2100].map((v) => (<g><line x1={L} x2={W - R} y1={sy(v)} y2={sy(v)} /><text x={L - 6} y={sy(v) + 4} text-anchor="end">{v.toLocaleString()}</text></g>))}
    {[6, 7, 8].map((v) => (<text x={sx(v)} y={H - B + 18} text-anchor="middle">{v}%</text>))}
  </g>
  <text x={L + 2} y={T + 2} class="ax">Housing starts, thousands</text>
  <text x={W - R} y={H - 4} class="ax" text-anchor="end">30-year mortgage rate</text>

  <g class="sq-mean">{pts.map((p, i) => { const s = sq(p, my); return <rect x={s.x} y={s.y} width={s.s} height={s.s} style={`--i:${i}`} />; })}</g>
  <g class="sq-ols">{pts.map((p, i) => { const s = sq(p, b0 + b1 * p.x); return <rect x={s.x} y={s.y} width={s.s} height={s.s} style={`--i:${i}`} />; })}</g>
  <line x1={L + 8} x2={W - R - 8} y1={cy} y2={cy} class="fit" style={`transform-origin:${cx}px ${cy}px; --a:${angle}deg`} />
  {pts.map((p, i) => <circle cx={sx(p.x)} cy={sy(p.y)} r="4.2" class="pt" style={`--i:${i}`} />)}
  <circle cx={cx} cy={cy} r="5" class="pivot" />

  <g transform={`translate(${L}, ${H + 14})`} class="bars">
    <text x="0" y="-6" class="bl">Total area of the squares</text>
    <text x="0" y="11" class="bl">Around the average</text>
    <rect x="140" y="2" height="12" rx="3" width={barW} class="b1" />
    <text x="0" y="37" class="bl">Around the fitted line</text>
    <rect x="140" y="28" height="12" rx="3" width={barW * (sse / sst)} class="b2" />
    <text x={146 + barW * (sse / sst)} y="38" class="bv">{Math.round((sse / sst) * 100)}% left, so R² = {(1 - sse / sst).toFixed(2)}</text>
    <text x="0" y="64" class="note">Each dot is one year, 1993–2007. Data: FRED (HOUST, MORTGAGE30US).</text>
  </g>
</svg>
<style>
  .rh { max-width: 560px; }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .grid text, .ax { font: 500 12px var(--font-ui); fill: var(--muted); }
  .pt { fill: var(--c-history); stroke: var(--surface); stroke-width: 1.5; opacity: 0; animation: pop .35s calc(var(--i) * 45ms) cubic-bezier(.05,.7,.1,1) forwards; }
  .pivot { fill: var(--surface); stroke: var(--c-forecast); stroke-width: 2; opacity: 0; animation: fade .3s 1.1s forwards; }
  rect { stroke-width: 1; }
  .sq-mean rect { fill: color-mix(in srgb, var(--danger) 14%, transparent); stroke: color-mix(in srgb, var(--danger) 55%, transparent); opacity: 0; animation: inout 2.2s calc(.7s + var(--i) * 30ms) forwards; }
  .sq-ols rect { fill: color-mix(in srgb, var(--c-fitted) 16%, transparent); stroke: color-mix(in srgb, var(--c-fitted) 60%, transparent); opacity: 0; animation: fade .5s 2.55s forwards; }
  .fit { stroke: var(--c-forecast); stroke-width: 3; stroke-linecap: round; transform-box: view-box; opacity: 0; animation: fade .3s .9s forwards, rot .9s 1.7s cubic-bezier(.2,0,0,1) forwards; }
  .bl { font: 600 12px var(--font-ui); fill: var(--text-2); }
  .bv { font: 600 12px var(--font-ui); fill: var(--text); opacity: 0; animation: fade .4s 3s forwards; }
  .note { font: 500 12px var(--font-ui); fill: var(--muted); }
  .b1 { fill: color-mix(in srgb, var(--danger) 60%, transparent); transform-box: fill-box; transform-origin: left; transform: scaleX(0); animation: grow .6s 1s cubic-bezier(.2,.8,.2,1) forwards; }
  .b2 { fill: var(--c-fitted); transform-box: fill-box; transform-origin: left; transform: scaleX(0); animation: grow .6s 2.6s cubic-bezier(.2,.8,.2,1) forwards; }
  @keyframes pop { from { opacity: 0; transform: scale(.4); transform-box: fill-box; transform-origin: center; } to { opacity: 1; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes inout { 0% { opacity: 0; } 20% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: .0; } }
  @keyframes rot { from { transform: rotate(0deg); } to { transform: rotate(var(--a)); } }
  @keyframes grow { to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .pt, .pivot, .sq-ols rect, .bv { animation: none; opacity: 1; }
    .sq-mean rect { animation: none; opacity: 0; }
    .fit { animation: none; opacity: 1; transform: rotate(var(--a)); }
    .b1, .b2 { animation: none; transform: none; }
  }
</style>
