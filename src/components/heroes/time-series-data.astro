---
// Signature hero for Chapter 1: a continuous economy is sampled into monthly observations,
// aggregated into quarters, and a forecast is made from the information set up to "today".
const W = 520;
const X0 = 26, XT = 372, XE = 500; // left edge, "today", right edge
const N = 30; // monthly observations up to today
const f = (u: number) => 132 - 46 * u - 15 * Math.sin(u * 9.2) - 6 * Math.sin(u * 23 + 1); // y in px (smaller = higher)
const ux = (x: number) => (x - X0) / (XE - X0);
const curve = Array.from({ length: 160 }, (_, i) => {
  const x = X0 + (i / 159) * (XT - X0);
  return `${i ? 'L' : 'M'}${x.toFixed(1)},${f(ux(x)).toFixed(1)}`;
}).join('');
const future = Array.from({ length: 50 }, (_, i) => {
  const x = XT + (i / 49) * (XE - XT);
  return `${i ? 'L' : 'M'}${x.toFixed(1)},${f(ux(x)).toFixed(1)}`;
}).join('');
const step = (XT - X0) / (N - 1);
const dots = Array.from({ length: N }, (_, i) => ({ x: X0 + i * step, y: f(ux(X0 + i * step)) }));
// quarterly averages of the monthly dots, drawn in a lower strip
const QY0 = 248, scaleQ = 0.55;
const quarters = Array.from({ length: N / 3 }, (_, q) => {
  const g = dots.slice(q * 3, q * 3 + 3);
  const m = g.reduce((a, d) => a + d.y, 0) / g.length;
  return { x1: g[0].x - step / 2, x2: g[2].x + step / 2, y: QY0 + (m - 90) * scaleQ };
});
// the forecast: h = 6 months ahead of today
const last = dots[N - 1];
const H = 6, FX = XT + H * step;
const FY = f(ux(FX)) + 6; // point forecast (close to, not exactly, the truth)
const band = 30;
---
<svg viewBox={`0 0 ${W} 330`} class="tsh" role="img" aria-label="A continuous line is sampled into monthly dots, averaged into quarterly bars, and extended by a forecast with an uncertainty band six months past today">
  <!-- strip labels -->
  <text x={X0} y="22" class="lbl">The economy, continuously</text>
  <text x={X0} y="208" class="lbl">What a quarterly series records</text>

  <!-- continuous truth (past), then unknown future -->
  <path d={curve} class="truth" pathLength="1" />
  <path d={future} class="fut" />

  <!-- monthly samples -->
  <g class="samples">
    {dots.map((d, i) => (
      <g style={`--d:${(0.9 + i * 0.035).toFixed(3)}s`}>
        <line x1={d.x} x2={d.x} y1={d.y} y2="180" class="tick" />
        <circle cx={d.x} cy={d.y} r="3.3" class="dot" />
      </g>
    ))}
  </g>
  <text x={X0} y="196" class="cap s1">monthly observations</text>

  <!-- quarterly aggregation -->
  <g class="quarters">
    {quarters.map((q, i) => (
      <line x1={q.x1 + 1.5} x2={q.x2 - 1.5} y1={q.y} y2={q.y} class="qbar" style={`--d:${(2.05 + i * 0.04).toFixed(2)}s`} />
    ))}
  </g>

  <!-- today + information set -->
  <line x1={XT} x2={XT} y1="34" y2="290" class="today" />
  <text x={XT - 5} y="44" class="cap end s2">today</text>
  <path d={`M${X0} 296 v6 H${XT} v-6`} class="brace" />
  <text x={(X0 + XT) / 2} y="318" class="cap mid s2">information set: everything known today</text>

  <!-- the forecast -->
  <g class="fc">
    <path d={`M${last.x},${last.y} L${FX},${FY - band} L${FX},${FY + band} Z`} class="fan" />
    <line x1={last.x} y1={last.y} x2={FX} y2={FY} class="fcl" />
    <line x1={FX} x2={FX} y1={FY - band} y2={FY + band} class="whisk" />
    <circle cx={FX} cy={FY} r="5" class="fdot" />
    <text x={FX + 9} y={FY + 4} class="cap fct">forecast</text>
    <path d={`M${XT} 268 H${FX}`} class="hor" marker-end="url(#tsh-a)" />
    <text x={(XT + FX) / 2} y="284" class="cap mid fct">horizon h</text>
  </g>
  <defs>
    <marker id="tsh-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="var(--c-forecast)" /></marker>
  </defs>
</svg>
<style>
  .tsh { max-width: 560px; width: 100%; overflow: visible; }
  .lbl { font: 650 12px var(--font-ui); fill: var(--muted); }
  .cap { font: 500 12px var(--font-ui); fill: var(--text-2); }
  .cap.end { text-anchor: end; }
  .cap.mid { text-anchor: middle; }
  .truth { fill: none; stroke: var(--c-history); stroke-width: 1.4; stroke-opacity: .55; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s cubic-bezier(.65,0,.35,1) forwards; }
  .fut { fill: none; stroke: var(--c-history); stroke-width: 1.2; stroke-opacity: .22; stroke-dasharray: 2 5; opacity: 0; animation: fade .5s 2.6s forwards; }
  .tick { stroke: var(--c-fitted); stroke-opacity: .16; stroke-width: 1; }
  .dot { fill: var(--c-fitted); }
  .samples g { opacity: 0; transform-box: fill-box; animation: pop .35s var(--d) cubic-bezier(.05,.7,.1,1) forwards; }
  .qbar { stroke: var(--ch, var(--c-fitted)); stroke-width: 5; stroke-linecap: round; opacity: 0; animation: fade .35s var(--d) forwards; }
  .today { stroke: var(--border-strong); stroke-dasharray: 3 4; opacity: 0; animation: fade .3s 2.35s forwards; }
  .brace { fill: none; stroke: var(--border-strong); stroke-width: 1.2; opacity: 0; animation: fade .4s 2.45s forwards; }
  .s1 { opacity: 0; animation: fade .4s 1.6s forwards; }
  .s2 { opacity: 0; animation: fade .4s 2.45s forwards; }
  .fc { opacity: 0; animation: fade .5s 2.65s forwards; }
  .fan { fill: var(--c-band); fill-opacity: .2; }
  .fcl { stroke: var(--c-forecast); stroke-width: 2; stroke-dasharray: 5 4; }
  .whisk { stroke: var(--c-forecast); stroke-width: 2; }
  .fdot { fill: var(--c-forecast); stroke: var(--surface); stroke-width: 2; }
  .fct { fill: var(--accent-text); font-weight: 650; }
  .hor { stroke: var(--c-forecast); stroke-width: 1.4; fill: none; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .truth, .fut, .samples g, .qbar, .today, .brace, .s1, .s2, .fc { animation: none; opacity: 1; stroke-dashoffset: 0; transform: none; }
    .fut { opacity: 1; }
  }
</style>
