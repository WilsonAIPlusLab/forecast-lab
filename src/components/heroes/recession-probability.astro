---
// Signature hero for Chapter 9: real yield-curve recession probabilities (logit fitted in the chapter's labs)
// drawn across 1960–2027 under shaded NBER recessions, then a gauge needle swings to the 2023 peak and settles on today.
import fs from 'node:fs';
import path from 'node:path';

const read = (id: string) => {
  const txt = fs.readFileSync(path.resolve(process.cwd(), 'public/data', `${id}.csv`), 'utf8');
  const m = new Map<string, number>();
  for (const l of txt.trim().split('\n').slice(1)) { const [d, v] = l.split(','); const x = parseFloat(v); if (Number.isFinite(x)) m.set(d.slice(0, 7), x); }
  return m;
};
const gs10 = read('GS10'), tb3 = read('TB3MS'), usrec = read('USREC');
// Logit estimated in the chapter (glm on Jan 1959 – Oct 2025): log-odds = −1.1341 − 1.0137 × spread
const A = -1.1341, B = -1.0137;
const pts: { t: number; p: number; key: string }[] = [];
for (const [k, g] of gs10) {
  if (k < '1959-01') continue;
  const b = tb3.get(k); if (b == null) continue;
  const [y, mo] = k.split('-').map(Number);
  const t = y + (mo - 1) / 12 + 1; // dated at the month forecast (12 months later)
  pts.push({ t, p: 1 / (1 + Math.exp(-(A + B * (g - b)))), key: k });
}
const W = 520, X0 = 24, X1 = 500, T0 = 1960, T1 = 2028;
const Y0 = 352, Y1 = 234; // probability 0 → Y0, 1 → Y1
const x = (t: number) => X0 + ((t - T0) / (T1 - T0)) * (X1 - X0);
const yv = (p: number) => Y0 - p * (Y0 - Y1);
const line = pts.filter((d) => d.t >= T0).map((d, i) => `${i ? 'L' : 'M'}${x(d.t).toFixed(1)},${yv(d.p).toFixed(1)}`).join('');
const area = `${line}L${x(pts[pts.length - 1].t).toFixed(1)},${Y0}L${x(T0).toFixed(1)},${Y0}Z`;
// recession spans
const spans: { a: number; b: number }[] = [];
let start: number | null = null;
for (const [k, v] of usrec) {
  if (k < '1960-01') continue;
  const [y, mo] = k.split('-').map(Number); const t = y + (mo - 1) / 12;
  if (v === 1 && start === null) start = t;
  if (v === 0 && start !== null) { spans.push({ a: start, b: t }); start = null; }
}
const last = pts[pts.length - 1];
const peak = pts.filter((d) => d.key >= '2022-01' && d.key <= '2024-12').reduce((m, d) => (d.p > m.p ? d : m));
// gauge
const GX = 260, GY = 150, R = 100;
const ang = (p: number) => Math.PI * (1 - p); // 0 → left, 1 → right
const arc = (p0: number, p1: number, r: number) => {
  const a0 = ang(p0), a1 = ang(p1);
  return `M${(GX + r * Math.cos(a0)).toFixed(1)},${(GY - r * Math.sin(a0)).toFixed(1)} A${r},${r} 0 0 1 ${(GX + r * Math.cos(a1)).toFixed(1)},${(GY - r * Math.sin(a1)).toFixed(1)}`;
};
const degPeak = (peak.p * 180 - 90).toFixed(1), degNow = (last.p * 180 - 90).toFixed(1);
const ticks = [0, 0.25, 0.5, 0.75, 1];
const pctTxt = (p: number) => `${Math.round(100 * p)}%`;
const monTxt = (key: string, add = 12) => { const [y, m] = key.split('-').map(Number); const d = new Date(y, m - 1 + add, 1); return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }); };
---
<svg viewBox={`0 0 ${W} 380`} class="rh" role="img" aria-label={`Yield-curve recession probability, 1960 to 2027, with NBER recessions shaded. The gauge swings to ${pctTxt(peak.p)} (the forecast for ${monTxt(peak.key)}) and settles at ${pctTxt(last.p)} for ${monTxt(last.key)}.`} style={`--peak:${degPeak}deg;--now:${degNow}deg`}>
  <!-- gauge -->
  <path d={arc(0, 1, R)} class="g-track" />
  <path d={arc(0, 0.3, R)} class="g-zone z1" />
  <path d={arc(0.3, 0.5, R)} class="g-zone z2" />
  <path d={arc(0.5, 1, R)} class="g-zone z3" />
  {ticks.map((p) => (
    <text x={GX + (R + 16) * Math.cos(ang(p))} y={GY - (R + 16) * Math.sin(ang(p)) + 4} class="g-tick" text-anchor="middle">{pctTxt(p)}</text>
  ))}
  <g class="needle">
    <line x1={GX} y1={GY} x2={GX} y2={GY - R + 14} />
    <circle cx={GX} cy={GY} r="7" />
  </g>
  <text x={GX} y={GY + 40} class="g-now" text-anchor="middle">{pctTxt(last.p)}</text>
  <text x={GX} y={GY + 57} class="g-lbl" text-anchor="middle">chance {monTxt(last.key)} is a recession month</text>
  <text x="20" y="40" class="g-peak">2023 peak: {pctTxt(peak.p)}</text>
  <text x="20" y="55" class="g-peak">(forecast for {monTxt(peak.key)})</text>

  <!-- timeline -->
  {spans.map((s) => <rect x={x(s.a)} y={Y1 - 4} width={Math.max(2, x(s.b) - x(s.a))} height={Y0 - Y1 + 4} class="rec" />)}
  <line x1={X0} x2={X1} y1={Y0} y2={Y0} class="axis" />
  <line x1={X0} x2={X1} y1={yv(0.5)} y2={yv(0.5)} class="half" />
  <text x={X0} y={yv(0.5) - 4} class="ax">50%</text>
  <path d={area} class="area" />
  <path d={line} class="pline" pathLength="1" />
  {[1960, 1980, 2000, 2020].map((t) => <text x={x(t)} y={Y0 + 16} class="ax" text-anchor="middle">{t}</text>)}
  <text x={X1} y={Y1 - 10} class="ax" text-anchor="end">grey = NBER recession</text>
  <text x={X0} y={Y1 - 10} class="ax">P(recession), dated at the month forecast</text>
</svg>
<style>
  .rh { max-width: 560px; }
  .g-track { fill: none; stroke: var(--surface-3); stroke-width: 16; }
  .g-zone { fill: none; stroke-width: 16; opacity: 0; animation: fade .5s .1s forwards; }
  .z1 { stroke: color-mix(in srgb, var(--c-s1) 55%, transparent); }
  .z2 { stroke: color-mix(in srgb, var(--warm) 60%, transparent); }
  .z3 { stroke: color-mix(in srgb, var(--danger) 70%, transparent); }
  .g-tick { font: 600 12px var(--font-ui); fill: var(--muted); }
  .needle { transform-origin: 260px 150px; transform: rotate(-90deg); animation: swing 2.4s 1.2s cubic-bezier(.3,.7,.2,1) forwards; }
  .needle line { stroke: var(--text); stroke-width: 3.5; stroke-linecap: round; }
  .needle circle { fill: var(--text); }
  .g-now { font: 700 30px var(--font-ui); fill: var(--text); font-variant-numeric: tabular-nums; opacity: 0; animation: fade .5s 3.2s forwards; }
  .g-lbl { font: 500 12px var(--font-ui); fill: var(--muted); opacity: 0; animation: fade .5s 3.3s forwards; }
  .g-peak { font: 600 12px var(--font-ui); fill: var(--danger); opacity: 0; animation: blip 1.6s 1.9s forwards; }
  .rec { fill: var(--muted); opacity: 0; animation: recf .6s .2s forwards; }
  .axis { stroke: var(--border-strong); }
  .half { stroke: var(--border-strong); stroke-dasharray: 3 4; }
  .ax { font: 500 12px var(--font-ui); fill: var(--muted); }
  .pline { fill: none; stroke: var(--c-forecast); stroke-width: 2; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.8s .3s cubic-bezier(.45,0,.3,1) forwards; }
  .area { fill: var(--c-forecast); opacity: 0; animation: areaf .8s 1.6s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes recf { to { opacity: .22; } }
  @keyframes areaf { to { opacity: .14; } }
  @keyframes blip { 0% { opacity: 0; } 25% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: .55; } }
  @keyframes swing { 0% { transform: rotate(-90deg); } 45% { transform: rotate(var(--peak)); } 60% { transform: rotate(var(--peak)); } 100% { transform: rotate(var(--now)); } }
  @media (prefers-reduced-motion: reduce) {
    .needle { animation: none; transform: rotate(var(--now)); }
    .pline { animation: none; stroke-dashoffset: 0; }
    .g-zone, .g-now, .g-lbl, .area, .rec, .g-peak { animation: none; }
    .g-zone, .g-now, .g-lbl { opacity: 1; } .area { opacity: .14; } .rec { opacity: .22; } .g-peak { opacity: .55; }
  }
</style>
